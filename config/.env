# Base domain for all services
BASE_DOMAIN=codethebox.dev

# Email for Let's Encrypt
LETSENCRYPT_EMAIL=admin@example.com

# Rancher bootstrap password
RANCHER_BOOTSTRAP_PASSWORD=admin

# SSL mode: "letsencrypt" or "custom"
SSL_MODE=letsencrypt

# Custom cert paths (only used if SSL_MODE=custom)
CUSTOM_SSL_CERT=/rancher-traefik/certs/tls.crt
CUSTOM_SSL_KEY=/rancher-traefik/certs/tls.key
